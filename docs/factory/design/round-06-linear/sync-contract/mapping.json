  "queryExamples": {
    "statusDiscovery": "query States($teamId: ID!, $after: String) { workflowStates(first: 50, after: $after, includeArchived: true, filter: { team: { id: { eq: $teamId } } }) { nodes { id name type position archivedAt updatedAt team { id } inheritedFrom { id } } pageInfo { hasNextPage endCursor } } }",
    "incremental": "query Issues($filter: IssueFilter!, $after: String) { issues(first: 50, after: $after, orderBy: updatedAt, includeArchived: true, filter: $filter) { nodes { id identifier url title description updatedAt archivedAt trashed priority team { id } project { id } state { id name type } assignee { id } delegate { id } } pageInfo { hasNextPage endCursor } } }",
    "incrementalFilterExample": {
      "team": {
        "id": {
          "eq": "20000000-0000-4000-8000-000000000001"
        }
      },
      "updatedAt": {
        "gte": "2026-11-04T17:50:00Z",
        "lte": "2026-11-04T18:15:00Z"
      }
    },
    "explicitStateMutation": "mutation SetSourceState($id: String!, $stateId: String!) { issueUpdate(id: $id, input: { stateId: $stateId }) { success issue { id updatedAt team { id } state { id name type } } } }",
    "exampleQualification": "Schema-inspected illustrative operations, not executed against a workspace. Nested labels require their own cursor pagination if selected."
